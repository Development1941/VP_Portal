# Copy this file to .env. The app reads that one file only.
# Leave the Supabase values blank to run the local demo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key (sb_secret_...). Required to create team members from the Team page.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URL used to apply supabase/schema.sql. Not read by the Next.js app.
DATABASE_URL=

# Optional signature secret for the local demo session cookie.
DEMO_AUTH_SECRET=
